# Copie ce fichier en .env et remplis les valeurs.
# Ne commit JAMAIS le .env reel.

NODE_ENV=production
PORT=3000

# Mot de passe du panneau admin (/admin-stats.html).
# Doit etre un hex de 64 caracteres (le serveur refuse tout autre format).
MOD_PASSWORD=
STATS_PASSWORD=

# Redis (obligatoire sur Render : le disque est ephemere).
# Sans REDIS_URL, les donnees sont stockees dans ./data (effacees a chaque redemarrage).
REDIS_URL=

# Relais TURN. Deux modes :
#  - Twilio : renseigne TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN
#  - classique : renseigne TURN_URL + TURN_SECRET (ou TURN_AUTH_SECRET)
TURN_URL=
TURN_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
